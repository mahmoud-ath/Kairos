node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
next-env.d.ts

# Production
dist/

# Local database files (never commit user data)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal
/data/

# Backups (private user data)
*.kairos.json
backups/

# Environment / secrets
# `.env.*.local` covers .env.production.local, .env.vercel.local, …
# The plain per-environment files are listed explicitly: they hold the same
# secrets but are NOT matched by the *.local rule.
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging
.env.test
# Keep the documented template tracked:
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo
.vercel
.env*
