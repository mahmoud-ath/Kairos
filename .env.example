# ---------------------------------------------------------------------------
# Kairos environment configuration
# Copy this file to `.env` and adjust values as needed.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the application at runtime.
#
# Vercel + Prisma Postgres (DEPLOYMENT.md §11.1) — the POOLED host:
#   postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
#
# Vercel + Supabase (DEPLOYMENT.md §10.3) — the pooler on port 6543:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#
# Local development: any PostgreSQL, e.g. the `db` service in compose.yaml.
DATABASE_URL="postgresql://kairos:kairos@localhost:5432/kairos"

# Direct (unpooled) connection, used by `prisma migrate`, Studio and pg_dump.
# Only the CLI needs it: the running app starts on DATABASE_URL alone, so a
# missing DIRECT_URL breaks migrations, never the server (DEPLOYMENT.md §11.1).
#   Prisma Postgres: postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
#   Supabase:        the session/direct connection on port 5432
#   Locally:         the same value as DATABASE_URL
DIRECT_URL="postgresql://kairos:kairos@localhost:5432/kairos"

# Password of the PostgreSQL `db` service in compose.yaml (user and database are
# both `kairos`). Compose builds its own DATABASE_URL from this value, so change
# them together — and run `docker compose down -v` afterwards, because PostgreSQL
# reads this only when the volume is created for the first time.
KAIROS_DB_PASSWORD=kairos

# Port the Next.js server listens on inside the container. `next dev` uses 3000.
PORT=3000

# Host interface the Docker container binds to, and the host port it is
# published on. Keep this bound to 127.0.0.1 unless Supabase Auth is configured
# below, or you have put another authentication layer in front of Kairos.
KAIROS_BIND_HOST=127.0.0.1
KAIROS_PORT=3000

# --- Authentication (required) ---------------------------------------------
# Set both: every app route then requires a signed-in Supabase user, and
# `/login` is served to everyone else. NEXT_PUBLIC_* values are inlined at
# build time, so they have to be present when the image is built:
#
#   docker compose up -d --build      # correct: values reach the build
#   docker compose up -d              # reuses the old image, new values ignored
#
# Leaving them empty is a deployment error: the app refuses to serve requests
# rather than fall back to one shared workspace. To run local development with
# no Supabase project at all, set KAIROS_AUTH_DISABLED=true instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed to sign in. Empty = any user that
# exists in the Supabase project. Leave it empty on a public app: it signs out
# everybody who is not listed.
KAIROS_ALLOWED_EMAILS=

# "true" removes the sign-in gate entirely, so every visitor shares the `local`
# workspace. Local development and the Playwright suite only.
KAIROS_AUTH_DISABLED=false

# Absolute URL this deployment is served from. Used for canonical links, the
# sitemap and social metadata, so set it to the real origin before you put
# Kairos behind a domain. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to tell every crawler to stay away (robots.txt `Disallow: /`).
# The default is an indexable app: views are public, `/api/` never is.
KAIROS_NO_INDEX=false

# --- Daily reminder (Web Push) ---------------------------------------------
# Optional. Leave the whole block empty and Kairos works exactly as before;
# Settings then says notifications are not configured for this deployment.
#
# Generate a key pair once, with Bun:
#
#   bunx web-push generate-vapid-keys --json
#
# Then keep the private key on the server, and put the public key in BOTH
# variables below. It is public by design — it is sent to the browser so that it
# can subscribe — but it has to be present at build time as well, which is why it
# is mirrored into a NEXT_PUBLIC_* name.
#
# Rotating the pair invalidates every existing subscription: devices simply have
# to switch the reminder on again.
#
# The public half of the VAPID pair (87 characters). Safe to ship to a browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The private half (43 characters). Server-side only — never expose this.
VAPID_PRIVATE_KEY=
# Contact for the push services, in the form `mailto:you@example.com` (or an
# https: URL). They use it to reach the operator of a badly behaved app.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the scheduled reminder broadcast, at least 16 random
# characters, e.g. `openssl rand -base64 32`.
#
# The endpoint is reachable without a session, so this secret is its
# authentication: with none configured, every call is refused.
#
#   curl -H "Authorization: Bearer $KAIROS_CRON_SECRET" \
#     https://<your-app>/api/cron/daily-reminder
#
# On Vercel, name it CRON_SECRET instead: Vercel then attaches the
# Authorization header to its own cron invocations for you. Both names are
# accepted, this one first.
KAIROS_CRON_SECRET=

# --- Rate limiting ---------------------------------------------------------
# Where the counters live. Without these, limits are enforced in the memory of
# ONE process: real for `next dev`, the compose stack and Playwright, and useless
# on Vercel, where several instances serve the same account (the app logs a
# warning once when that happens).
#
# Upstash shows both in its console (REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where the counters live: upstash | postgres | memory. Leave unset to let the app
# decide — Upstash when configured, PostgreSQL on a hosted deployment, memory for a
# local run. Forcing it is how the integration tests exercise the shared stores.
KAIROS_RATE_LIMIT_STORE=
# Turns the limiter off for a local run — a spec suite is a script, not a person.
# IGNORED on a hosted deployment (VERCEL / VERCEL_ENV), like KAIROS_AUTH_DISABLED.
KAIROS_RATE_LIMIT_DISABLED=
