# ---------------------------------------------------------------------------
# Kairos environment configuration
# Copy this file to `.env` and adjust values as needed.
# ---------------------------------------------------------------------------

# SQLite connection string.
#
# Local development: the path is resolved relative to `prisma/schema.prisma`,
# so a bare `file:./dev.db` points at `prisma/dev.db`.
#
# Docker: the database lives on the persistent volume mounted at `/data`.
# Use an absolute path there (`file:/data/kairos.db`).
DATABASE_URL="file:./dev.db"

# Port the Next.js server listens on inside the container. `next dev` uses 3000.
PORT=3000

# Host interface the Docker container binds to, and the host port it is
# published on. Keep this bound to 127.0.0.1 unless you have added
# authentication in front of Kairos — this version has none.
KAIROS_BIND_HOST=127.0.0.1
KAIROS_PORT=3000
