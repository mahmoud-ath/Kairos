# ---------------------------------------------------------------------------
# Kairos environment configuration
# Copy this file to `.env` and adjust values as needed.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the application at runtime.
#
# Vercel + Supabase (see DEPLOYMENT.md §10.3): use the POOLED connection on
# port 6543.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#
# Local development: any PostgreSQL, e.g. the `db` service in compose.yaml.
DATABASE_URL="postgresql://kairos:kairos@localhost:5432/kairos"

# Unpooled connection, used by `prisma migrate` only. On Supabase this is the
# session/direct connection on port 5432. Locally it equals DATABASE_URL.
DIRECT_URL="postgresql://kairos:kairos@localhost:5432/kairos"

# Port the Next.js server listens on inside the container. `next dev` uses 3000.
PORT=3000

# Host interface the Docker container binds to, and the host port it is
# published on. Keep this bound to 127.0.0.1 unless Supabase Auth is configured
# below, or you have put another authentication layer in front of Kairos.
KAIROS_BIND_HOST=127.0.0.1
KAIROS_PORT=3000

# --- Authentication (optional) ---------------------------------------------
# With both values set, every app route requires a signed-in Supabase user and
# `/login` is served instead. Leave them empty to run without a sign-in gate.
# NEXT_PUBLIC_* values are inlined at build time: change them and rebuild.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed to sign in. Empty = any user that
# exists in the Supabase project.
KAIROS_ALLOWED_EMAILS=

# Escape hatch: "true" disables the gate even when Supabase is configured.
# The Playwright suite sets this, and so may a private deployment.
KAIROS_AUTH_DISABLED=false

# Absolute URL this deployment is served from. Used for canonical links, the
# sitemap and social metadata, so set it to the real origin before you put
# Kairos behind a domain. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to tell every crawler to stay away (robots.txt `Disallow: /`).
# The default is an indexable app: views are public, `/api/` never is.
KAIROS_NO_INDEX=false
